{
  "name": "dotdog",
  "version": "1.0.0",
  "description": "CLI tool for structured software specifications. Validate .dog files, compile .dag graphs, query via MCP.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "dotdog": "dist/cli.js",
    "spec": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "kits/",
    "skills/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "agent",
    "ai",
    "bun",
    "cli",
    "dag",
    "graph",
    "knowledge-graph",
    "llm",
    "markdown",
    "mcp",
    "mcp-server",
    "spec-driven-development",
    "specification",
    "spec-kit",
    "structured",
    "typescript",
    "yaml"
  ],
  "license": "MIT",
  "author": "Justin Diclemente",
  "repository": "github:specdog/dotdog",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://specdog.github.io/dotdog",
  "bugs": {
    "url": "https://github.com/specdog/dotdog/issues"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && bun build src/cli.ts src/types/type-worker.ts --outdir dist --target node --minify-syntax --minify-whitespace --splitting"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "gpt-tokenizer": "4.1.0",
    "typescript": "^7.0.2"
  }
}

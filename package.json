{
  "name": "dotdog-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace for the dotdog CLI package.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/dotdog build",
    "lint": "bun run --cwd packages/dotdog lint",
    "test": "bun test",
    "pack:check": "node scripts/check-pack.mjs",
    "extension:check": "node scripts/check-speckit-extension.mjs",
    "validate": "bun packages/dotdog/src/cli.ts validate",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "dotdog": "workspace:*"
  }
}

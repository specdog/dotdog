{
  "name": "dotdog",
  "displayName": "dotdog",
  "description": "Syntax highlighting for .dog spec files",
  "version": "0.1.0",
  "publisher": "specdog",
  "license": "MIT",
  "repository": "https://github.com/specdog/dotdog",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "dotdog",
      "extensions": [".dog"],
      "aliases": ["dotdog", "dog"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "dotdog",
      "scopeName": "text.dog",
      "path": "./syntaxes/dog.tmLanguage.json"
    }]
  }
}
